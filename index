(function(){
  "use strict";

  /* ---------- Anno corrente nel footer ---------- */
  var y = document.getElementById("year");
  if (y) y.textContent = new Date().getFullYear();

  /* ---------- Menu mobile ---------- */
  var toggle = document.getElementById("menuToggle");
  var navLinks = document.getElementById("navLinks");

  function closeMenu(){
    navLinks.classList.remove("open");
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Apri il menu");
  }
  function openMenu(){
    navLinks.classList.add("open");
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Chiudi il menu");
  }
  toggle.addEventListener("click", function(){
    if (navLinks.classList.contains("open")) closeMenu(); else openMenu();
  });
  // Chiudi il menu quando si sceglie una voce
  navLinks.querySelectorAll("a").forEach(function(link){
    link.addEventListener("click", closeMenu);
  });
  // Chiudi con ESC
  document.addEventListener("keydown", function(e){
    if (e.key === "Escape" && navLinks.classList.contains("open")) { closeMenu(); toggle.focus(); }
  });

  /* ---------- Ombra header allo scroll ---------- */
  var header = document.querySelector(".site-header");
  var onScroll = function(){
    if (window.scrollY > 8) header.classList.add("scrolled");
    else header.classList.remove("scrolled");
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive:true });

  /* ---------- Reveal on scroll ---------- */
  var reveals = document.querySelectorAll(".reveal");
  if ("IntersectionObserver" in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting){
          entry.target.classList.add("visible");
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -40px 0px" });
    reveals.forEach(function(el){ io.observe(el); });
  } else {
    reveals.forEach(function(el){ el.classList.add("visible"); });
  }

  /* ---------- Validazione del modulo ---------- */
  var form = document.getElementById("formAdesione");
  var formBody = document.getElementById("formBody");
  var thanks = document.getElementById("thanksMsg");

  function setError(id, msg){
    var field = document.getElementById(id);
    var err = document.getElementById("err-" + id);
    if (msg){
      field.setAttribute("aria-invalid", "true");
      if (err) err.textContent = msg;
      return false;
    } else {
      field.removeAttribute("aria-invalid");
      if (err) err.textContent = "";
      return true;
    }
  }

  // Pulisce l'errore mentre l'utente digita/corregge
  ["nome","cognome","telefono","email","privacy"].forEach(function(id){
    var el = document.getElementById(id);
    var evt = (el.type === "checkbox") ? "change" : "input";
    el.addEventListener(evt, function(){ setError(id, ""); });
  });

  form.addEventListener("submit", function(e){
    e.preventDefault(); // <-- rimuovi questa riga se usi un action= verso un servizio

    var ok = true;
    var val = function(id){ return document.getElementById(id).value.trim(); };

    if (!val("nome"))    ok = setError("nome", "Inserisci il tuo nome.") && ok;
    if (!val("cognome")) ok = setError("cognome", "Inserisci il tuo cognome.") && ok;

    var tel = val("telefono").replace(/[\s.\-()]/g, "");
    if (!tel) ok = setError("telefono", "Inserisci un numero di telefono.") && ok;
    else if (!/^\+?\d{6,15}$/.test(tel)) ok = setError("telefono", "Numero non valido (solo cifre, min. 6).") && ok;

    var email = val("email");
    if (!email) ok = setError("email", "Inserisci la tua e-mail.") && ok;
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) ok = setError("email", "Indirizzo e-mail non valido.") && ok;

    if (!document.getElementById("privacy").checked)
      ok = setError("privacy", "Per aderire devi accettare l'informativa privacy.") && ok;

    if (!ok){
      // Porta il focus sul primo campo con errore
      var firstErr = form.querySelector('[aria-invalid="true"]');
      if (firstErr) firstErr.focus();
      return;
    }

    /* ====== SUCCESSO ======
       Qui i dati sono validi. In produzione, invia i dati al tuo servizio
       (Formspree / Google Form / e-mail). Esempio con fetch verso Formspree:

         fetch("https://formspree.io/f/IL_TUO_ID", {
           method: "POST",
           headers: { "Accept": "application/json" },
           body: new FormData(form)
         }).then(function(){ mostraGrazie(); });

       Per ora mostriamo subito il messaggio di conferma:
    */
    mostraGrazie();
  });

  function mostraGrazie(){
    formBody.hidden = true;
    thanks.hidden = false;
    // Porta il focus e lo scroll sul messaggio di ringraziamento
    thanks.setAttribute("tabindex", "-1");
    thanks.focus();
    thanks.scrollIntoView({ behavior: "smooth", block: "center" });
  }
})();
</script>
</body>
</html>
