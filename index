<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>I Commissari Siamo Noi — Comitato cittadino di Torre Annunziata</title>
<meta name="description" content="Un appello civico dei cittadini di Torre Annunziata per legalità, trasparenza e condizioni realmente libere. Diventa anche tu commissario." />

<!-- ===== Social preview (facoltativo: aggiorna URL/immagine quando pubblichi) ===== -->
<meta property="og:title" content="I Commissari Siamo Noi — Torre Annunziata" />
<meta property="og:description" content="Un appello civico per restituire la città ai suoi cittadini. Diventa anche tu commissario." />
<meta property="og:type" content="website" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
/* =========================================================================
   I COMMISSARI SIAMO NOI — Landing page
   Tutto in un unico file: HTML + CSS + JS. Nessuna dipendenza esterna
   oltre ai font Google. Per pubblicare: carica questo file su qualsiasi
   hosting (es. Netlify, Aruba, GitHub Pages) e rinominalo "index.html".

   -> PERSONALIZZAZIONE RAPIDA:
      • Colori .......... variabili :root qui sotto
      • Logo ............ variabile --logo nel :root (immagine WebP incorporata)
      • Contatti/social . nel <footer> (cerca "MODIFICA")
      • Invio modulo .... vedi commento "COLLEGA IL MODULO" nel <script>
   ========================================================================= */

:root{
  /* Logo del comitato — immagine WebP incorporata (vedi <span class="logo-badge">) */
  --logo: url("data:image/webp;base64,");
  /* --- Palette del logo --------------------------------------------- */
  --blu:        #0B4DA6;   /* colore guida */
  --blu-scuro:  #082A5E;   /* testi forti / bande scure / footer */
  --blu-chiaro: #1466D1;   /* accenti, hover, onde */
  --giallo:     #FFC61A;   /* accento energico / pulsanti principali */
  --giallo-sc:  #E7A800;   /* hover giallo */
  --rosso:      #E12B26;   /* urgenza / bandiera / accenti */
  --rosso-sc:   #C21F1B;
  --bianco:     #FFFFFF;
  --ghiaccio:   #F4F7FC;   /* sfondo sezioni chiare */
  --nero:       #14161A;   /* testo corpo */
  --grigio:     #5B6472;   /* testo secondario */
  --bordo:      #E3E8F0;

  /* --- Tipografia --------------------------------------------------- */
  --poster: "Anton", Impact, "Arial Narrow Bold", sans-serif;
  --testo:  "IBM Plex Sans", system-ui, -apple-system, Segoe UI, Roboto, sans-serif;

  /* --- Layout ------------------------------------------------------- */
  --max: 1160px;
  --gap: clamp(1rem, 4vw, 2rem);
  --radius: 16px;
  --radius-sm: 10px;
  --header-h: 68px;
  --shadow: 0 10px 30px rgba(8, 42, 94, .10);
  --shadow-lg: 0 22px 55px rgba(8, 42, 94, .18);
}

/* ============================ RESET ============================ */
*,*::before,*::after{ box-sizing:border-box; }
html{ scroll-behavior:smooth; -webkit-text-size-adjust:100%; }
body{
  margin:0;
  font-family:var(--testo);
  color:var(--nero);
  background:var(--bianco);
  line-height:1.65;
  font-size:clamp(1rem, .96rem + .2vw, 1.075rem);
  overflow-x:hidden;
}
img,svg{ display:block; max-width:100%; }
a{ color:inherit; text-decoration:none; }
button{ font-family:inherit; cursor:pointer; }
h1,h2,h3{ margin:0; line-height:1.06; }
p{ margin:0 0 1rem; }
ul{ margin:0; padding:0; list-style:none; }

/* Sezioni: offset per l'header sticky quando si usano le ancore */
section{ scroll-margin-top: calc(var(--header-h) + 12px); }

/* ============================ UTILITY ============================ */
.container{ width:min(100% - 2*var(--gap), var(--max)); margin-inline:auto; }
.eyebrow{
  font-family:var(--testo);
  font-weight:700;
  font-size:.78rem;
  letter-spacing:.18em;
  text-transform:uppercase;
  display:inline-flex;
  align-items:center;
  gap:.6rem;
  color:var(--blu);
}
.eyebrow::before{ content:""; width:26px; height:3px; background:var(--giallo); border-radius:3px; }
.section-title{
  font-family:var(--poster);
  text-transform:uppercase;
  font-weight:400;
  letter-spacing:.01em;
  color:var(--blu-scuro);
  font-size:clamp(1.9rem, 1.2rem + 3.2vw, 3.2rem);
  margin:.4rem 0 1rem;
}
.lead{ color:var(--grigio); font-size:1.08rem; max-width:62ch; }
.gia{ color:var(--giallo); }
.center{ text-align:center; }
.mx-auto{ margin-inline:auto; }

/* Link "salta al contenuto" per accessibilità */
.skip{
  position:absolute; left:12px; top:-60px; z-index:1000;
  background:var(--giallo); color:var(--blu-scuro);
  padding:.7rem 1rem; border-radius:8px; font-weight:700;
  transition:top .2s ease;
}
.skip:focus{ top:12px; }

/* Focus visibile su tutti gli elementi interattivi */
a:focus-visible, button:focus-visible, input:focus-visible, .btn:focus-visible{
  outline:3px solid var(--giallo);
  outline-offset:3px;
  border-radius:6px;
}

/* ============================ PULSANTI ============================ */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:.55rem;
  font-weight:700;
  font-size:1rem;
  padding:.95rem 1.7rem;
  border-radius:999px;
  border:2px solid transparent;
  transition:transform .18s ease, box-shadow .18s ease, background .18s ease, color .18s ease;
  text-align:center;
  line-height:1.15;
}
.btn:hover{ transform:translateY(-2px); }
.btn:active{ transform:translateY(0); }

/* Pulsante principale = claim ricorrente */
.btn--cta{
  background:var(--giallo);
  color:var(--blu-scuro);
  box-shadow:0 10px 24px rgba(255,198,26,.38);
  text-transform:uppercase;
  letter-spacing:.02em;
}
.btn--cta:hover{ background:var(--giallo-sc); box-shadow:0 14px 30px rgba(255,198,26,.5); }

.btn--ghost{
  background:transparent;
  color:var(--bianco);
  border-color:rgba(255,255,255,.7);
}
.btn--ghost:hover{ background:rgba(255,255,255,.12); border-color:#fff; }

.btn--solid{ background:var(--blu); color:#fff; }
.btn--solid:hover{ background:var(--blu-chiaro); }

.btn-icon{ width:1.15em; height:1.15em; }

/* Logo dentro un medaglione bianco: resta leggibile su qualsiasi sfondo.
   Regola il 82% per stringere/allargare il logo nel riquadro. */
.logo-badge{
  display:inline-block; flex:0 0 auto;
  background:#fff var(--logo) center / 82% no-repeat;
  border-radius:24%;
  box-shadow:0 4px 14px rgba(8,42,94,.20);
}

/* ============================ HEADER ============================ */
.site-header{
  position:sticky; top:0; z-index:100;
  background:var(--blu);
  border-bottom:1px solid rgba(255,255,255,.08);
  transition:box-shadow .25s ease, background .25s ease;
}
.site-header.scrolled{ box-shadow:0 6px 22px rgba(8,42,94,.28); background:var(--blu-scuro); }
.nav{
  height:var(--header-h);
  display:flex; align-items:center; justify-content:space-between; gap:1rem;
}
.brand{ display:flex; align-items:center; gap:.65rem; color:#fff; }
.brand .logo-badge{ width:42px; height:42px; }
.brand-name{
  font-family:var(--poster);
  text-transform:uppercase;
  font-size:.95rem;
  line-height:.98;
  letter-spacing:.02em;
  color:#fff;
}
.brand-name small{ display:block; color:var(--giallo); font-size:1.06em; }

.nav-links{ display:flex; align-items:center; gap:.35rem; }
.nav-links a{
  color:rgba(255,255,255,.92);
  font-weight:600; font-size:.95rem;
  padding:.55rem .8rem; border-radius:8px;
  transition:background .15s ease, color .15s ease;
}
.nav-links a:hover{ background:rgba(255,255,255,.12); color:#fff; }
.nav-links a.nav-cta{
  background:var(--giallo); color:var(--blu-scuro);
  font-weight:700; text-transform:uppercase; letter-spacing:.02em;
  margin-left:.4rem;
}
.nav-links a.nav-cta:hover{ background:var(--giallo-sc); }

/* Hamburger (mobile) */
.menu-toggle{
  display:none;
  width:46px; height:46px;
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.22);
  border-radius:10px;
  padding:0;
  align-items:center; justify-content:center;
}
.menu-toggle svg{ width:24px; height:24px; stroke:#fff; }
.menu-toggle .icon-close{ display:none; }
.menu-toggle[aria-expanded="true"] .icon-open{ display:none; }
.menu-toggle[aria-expanded="true"] .icon-close{ display:block; }

/* ============================ HERO ============================ */
.hero{
  position:relative;
  background:
    radial-gradient(1200px 600px at 78% -10%, rgba(20,102,209,.65), transparent 60%),
    radial-gradient(900px 500px at 10% 110%, rgba(8,42,94,.9), transparent 55%),
    linear-gradient(160deg, var(--blu) 0%, #0A4498 55%, var(--blu-scuro) 100%);
  color:#fff;
  padding:clamp(2.6rem, 6vw, 5rem) 0 0;
  overflow:hidden;
  text-align:center;
}
.hero__inner{ position:relative; z-index:2; padding-bottom:clamp(4rem, 9vw, 7rem); }
.hero .logo-badge{ display:block; width:clamp(88px, 15vw, 122px); height:clamp(88px, 15vw, 122px); margin:0 auto 1.1rem; box-shadow:0 16px 34px rgba(0,0,0,.30); }
.hero__eyebrow{
  color:var(--giallo);
  font-weight:700; letter-spacing:.24em; text-transform:uppercase;
  font-size:.78rem;
  display:inline-block; margin-bottom:1rem;
}
.hero h1{
  font-family:var(--poster);
  text-transform:uppercase;
  font-weight:400;
  font-size:clamp(2.6rem, 1.4rem + 7.5vw, 6rem);
  letter-spacing:.005em;
  line-height:.92;
  margin:0 auto .9rem;
  max-width:14ch;
  text-shadow:0 4px 24px rgba(0,0,0,.22);
}
.hero__subtitle{
  font-weight:600;
  font-size:clamp(1.15rem, 1rem + 1vw, 1.55rem);
  color:#eaf1ff;
  margin:0 auto .9rem;
  max-width:30ch;
}
.hero__text{
  color:rgba(255,255,255,.9);
  max-width:56ch; margin:0 auto 1.9rem;
  font-size:1.08rem;
}
.hero__actions{ display:flex; gap:.9rem; justify-content:center; flex-wrap:wrap; }

/* Onde in fondo alla hero (firma grafica ispirata al logo) */
.hero__waves{ position:absolute; left:0; right:0; bottom:-1px; z-index:1; line-height:0; }
.hero__waves svg{ width:100%; height:auto; }
.wave-move{ animation:drift 14s ease-in-out infinite alternate; }
.wave-move--slow{ animation-duration:22s; }
@keyframes drift{ from{ transform:translateX(-2%);} to{ transform:translateX(2%);} }

/* ============================ SEZIONE INTRO ============================ */
.intro{ background:var(--bianco); padding:clamp(3rem, 7vw, 5.5rem) 0; }
.intro__grid{ display:grid; grid-template-columns:1fr; gap:clamp(1.5rem, 4vw, 3rem); align-items:start; }
.intro__body p:last-child{ margin-bottom:0; }
.pull-quote{
  position:relative;
  background:var(--blu-scuro);
  color:#fff;
  border-radius:var(--radius);
  padding:clamp(1.6rem, 4vw, 2.4rem);
  box-shadow:var(--shadow-lg);
  overflow:hidden;
}
.pull-quote::before{
  content:"";
  position:absolute; inset:0 auto 0 0; width:8px;
  background:linear-gradient(var(--blu-chiaro), var(--giallo), var(--rosso));
}
.pull-quote .flag-mark{ width:40px; height:40px; margin-bottom:.6rem; }
.pull-quote q{
  font-family:var(--poster);
  text-transform:uppercase;
  font-weight:400;
  font-size:clamp(1.3rem, 1rem + 2vw, 2rem);
  line-height:1.1;
  quotes:none;
  display:block;
}
.pull-quote q .gia{ color:var(--giallo); }
.pull-quote figcaption{ margin-top:.9rem; color:#c7d6f0; font-size:.9rem; font-weight:600; letter-spacing:.02em; }

/* ============================ TRE CARD ============================ */
.pillars{ background:var(--ghiaccio); padding:clamp(3rem, 7vw, 5.5rem) 0; }
.pillars__head{ max-width:62ch; margin:0 auto 2.4rem; text-align:center; }
.cards{ display:grid; grid-template-columns:1fr; gap:1.25rem; }
.card{
  background:#fff;
  border:1px solid var(--bordo);
  border-radius:var(--radius);
  border-top:5px solid var(--blu);
  padding:1.7rem 1.6rem;
  box-shadow:var(--shadow);
  transition:transform .2s ease, box-shadow .2s ease;
}
.card:hover{ transform:translateY(-4px); box-shadow:var(--shadow-lg); }
.card:nth-child(2){ border-top-color:var(--giallo); }
.card:nth-child(3){ border-top-color:var(--rosso); }
.card__icon{
  width:56px; height:56px; border-radius:14px;
  display:grid; place-items:center; margin-bottom:1rem;
  background:rgba(11,77,166,.10); color:var(--blu);
}
.card:nth-child(2) .card__icon{ background:rgba(233,168,0,.16); color:#B57F00; }
.card:nth-child(3) .card__icon{ background:rgba(225,43,38,.12); color:var(--rosso); }
.card__icon svg{ width:30px; height:30px; }
.card h3{ font-size:1.3rem; color:var(--blu-scuro); margin-bottom:.5rem; letter-spacing:-.01em; }
.card p{ color:var(--grigio); margin:0; }

/* ============================ COSA CHIEDIAMO ============================ */
.asks{
  background:
    radial-gradient(900px 500px at 100% 0%, rgba(20,102,209,.4), transparent 55%),
    var(--blu-scuro);
  color:#fff;
  padding:clamp(3rem, 7vw, 5.5rem) 0;
}
.asks .eyebrow{ color:var(--giallo); }
.asks .eyebrow::before{ background:var(--giallo); }
.asks .section-title{ color:#fff; }
.asks__lead{ color:#c7d6f0; max-width:60ch; margin-bottom:2.2rem; }
.asks__list{ display:grid; gap:1rem; }
.ask-item{
  display:flex; gap:1rem; align-items:flex-start;
  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.12);
  border-radius:var(--radius-sm);
  padding:1.1rem 1.25rem;
}
.ask-item .tick{
  flex:0 0 auto; width:30px; height:30px; border-radius:50%;
  background:var(--giallo); color:var(--blu-scuro);
  display:grid; place-items:center; margin-top:2px;
}
.ask-item .tick svg{ width:18px; height:18px; }
.ask-item span{ font-weight:500; }
.asks__note{
  margin-top:1.8rem;
  font-size:.92rem; color:#a9bcdd;
  border-left:3px solid var(--giallo);
  padding-left:1rem;
  max-width:65ch;
}

/* ============================ PARTECIPA ============================ */
.join-cta{
  position:relative;
  background:
    radial-gradient(800px 480px at 12% 0%, rgba(20,102,209,.7), transparent 55%),
    linear-gradient(150deg, var(--blu) 0%, #0A4498 100%);
  color:#fff;
  padding:clamp(3.4rem, 8vw, 6rem) 0;
  text-align:center;
  overflow:hidden;
}
.join-cta h2{
  font-family:var(--poster);
  text-transform:uppercase; font-weight:400;
  font-size:clamp(2rem, 1.2rem + 4.5vw, 4rem);
  letter-spacing:.01em;
  margin-bottom:1rem;
}
.join-cta h2 .gia{ color:var(--giallo); }
.join-cta p{ color:#e9f1ff; max-width:56ch; margin:0 auto 1.9rem; font-size:1.1rem; }
.actions-row{
  display:flex; flex-wrap:wrap; gap:.8rem; justify-content:center;
  margin-bottom:2.1rem;
}
.action-pill{
  display:inline-flex; align-items:center; gap:.6rem;
  background:rgba(255,255,255,.08);
  border:1.5px solid var(--giallo);
  color:#fff; font-weight:700;
  text-transform:uppercase; letter-spacing:.04em; font-size:.95rem;
  padding:.7rem 1.3rem; border-radius:999px;
}
.action-pill svg{ width:20px; height:20px; color:var(--giallo); }

/* ============================ MODULO ============================ */
.enroll{ background:var(--ghiaccio); padding:clamp(3rem, 7vw, 5.5rem) 0; }
.enroll__wrap{
  background:#fff;
  border:1px solid var(--bordo);
  border-radius:calc(var(--radius) + 4px);
  box-shadow:var(--shadow-lg);
  overflow:hidden;
  max-width:720px; margin-inline:auto;
}
.enroll__banner{
  background:var(--blu-scuro); color:#fff;
  padding:clamp(1.6rem, 4vw, 2.2rem);
  text-align:center;
}
.enroll__banner .logo-badge{ display:block; width:62px; height:62px; margin:0 auto .8rem; }
.enroll__banner h2{
  font-family:var(--poster); text-transform:uppercase; font-weight:400;
  font-size:clamp(1.6rem, 1.1rem + 2.4vw, 2.4rem); letter-spacing:.01em;
}
.enroll__banner p{ color:#c7d6f0; margin:.5rem auto 0; max-width:46ch; }

.form-body{ padding:clamp(1.6rem, 4vw, 2.4rem); }
.form-grid{ display:grid; grid-template-columns:1fr; gap:1.1rem; }
.field{ display:flex; flex-direction:column; gap:.4rem; }
.field label{ font-weight:600; font-size:.95rem; color:var(--blu-scuro); }
.field label .req{ color:var(--rosso); }
.field input[type="text"],
.field input[type="tel"],
.field input[type="email"]{
  padding:.85rem 1rem;
  border:1.5px solid var(--bordo);
  border-radius:var(--radius-sm);
  font-size:1rem; font-family:inherit;
  background:#fff; color:var(--nero);
  transition:border-color .15s ease, box-shadow .15s ease;
}
.field input:focus{ outline:none; border-color:var(--blu); box-shadow:0 0 0 3px rgba(11,77,166,.15); }
.field input[aria-invalid="true"]{ border-color:var(--rosso); box-shadow:0 0 0 3px rgba(225,43,38,.14); }
.field .err{ color:var(--rosso-sc); font-size:.83rem; font-weight:600; min-height:0; }
.field .err:empty{ display:none; }

.privacy{
  display:flex; align-items:flex-start; gap:.7rem;
  background:var(--ghiaccio); border:1px solid var(--bordo);
  padding:.9rem 1rem; border-radius:var(--radius-sm);
}
.privacy input{ width:20px; height:20px; margin-top:3px; accent-color:var(--blu); flex:0 0 auto; }
.privacy label{ font-size:.9rem; color:var(--grigio); font-weight:500; }
.privacy a{ color:var(--blu); text-decoration:underline; font-weight:600; }

.form-note{
  margin-top:1.1rem;
  font-size:.85rem; color:var(--grigio);
  background:rgba(11,77,166,.05);
  border-left:3px solid var(--blu);
  padding:.75rem 1rem; border-radius:6px;
}
.submit-row{ margin-top:1.4rem; }
.submit-row .btn{ width:100%; }

/* Messaggio di ringraziamento */
.thanks{
  padding:clamp(2rem, 5vw, 3rem);
  text-align:center;
}
.thanks__check{
  width:72px; height:72px; margin:0 auto 1.1rem;
  border-radius:50%;
  background:rgba(11,77,166,.10); color:var(--blu);
  display:grid; place-items:center;
  animation:pop .4s ease;
}
.thanks__check svg{ width:40px; height:40px; }
@keyframes pop{ 0%{ transform:scale(.7); opacity:0;} 100%{ transform:scale(1); opacity:1;} }
.thanks h3{ font-family:var(--poster); text-transform:uppercase; font-weight:400; color:var(--blu-scuro); font-size:clamp(1.4rem,1.1rem+1.6vw,2rem); margin-bottom:.6rem; }
.thanks p{ color:var(--grigio); max-width:50ch; margin-inline:auto; }
.thanks .civic-note{ margin-top:1rem; font-size:.85rem; color:var(--grigio); font-style:italic; }
[hidden]{ display:none !important; }

/* ============================ FOOTER ============================ */
.site-footer{ background:var(--blu-scuro); color:#dfe8f6; padding:clamp(2.6rem,6vw,4rem) 0 1.6rem; }
.footer-grid{ display:grid; grid-template-columns:1fr; gap:2rem; }
.footer-brand{ display:flex; align-items:center; gap:.7rem; }
.footer-brand .logo-badge{ width:50px; height:50px; }
.footer-brand .brand-name{ color:#fff; }
.footer-col h4{ font-size:.8rem; letter-spacing:.16em; text-transform:uppercase; color:var(--giallo); margin:0 0 .9rem; }
.footer-col ul{ display:grid; gap:.55rem; }
.footer-col a, .footer-col address{ color:#c7d6f0; font-style:normal; font-size:.95rem; transition:color .15s ease; }
.footer-col a:hover{ color:#fff; }
.footer-col p{ color:#c7d6f0; font-size:.95rem; }
.socials{ display:flex; gap:.6rem; }
.socials a{
  width:42px; height:42px; border-radius:10px;
  display:grid; place-items:center;
  background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.14);
}
.socials a:hover{ background:rgba(255,255,255,.16); }
.socials svg{ width:22px; height:22px; fill:#fff; }
.footer-bottom{
  margin-top:2.4rem; padding-top:1.4rem;
  border-top:1px solid rgba(255,255,255,.12);
  display:flex; flex-wrap:wrap; gap:.6rem 1.4rem; align-items:center; justify-content:space-between;
  font-size:.85rem; color:#a9bcdd;
}
.footer-badge{
  display:inline-flex; align-items:center; gap:.5rem;
  font-weight:700; color:#fff; letter-spacing:.03em; text-transform:uppercase; font-size:.78rem;
}
.footer-badge::before{ content:""; width:22px; height:3px; background:var(--giallo); border-radius:3px; }

/* Divisori a onda tra sezioni chiare/scure */
.wave-divider{ line-height:0; }
.wave-divider svg{ width:100%; height:auto; display:block; }

/* ============================ REVEAL ON SCROLL ============================ */
.reveal{ opacity:0; transform:translateY(22px); transition:opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); }
.reveal.visible{ opacity:1; transform:none; }

